{
  "manifest_version": 3,
  "name": "AI伏せ字ガード – ChatGPT・Claude・Geminiに個人情報を送らない",
  "short_name": "AI伏せ字ガード",
  "description": "AIに送る前に、マイナンバー・電話番号・住所・氏名・登録した社名などを自動で伏せ字に。返答では元に戻して表示。処理はすべて端末内。",
  "version": "0.1.1",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/sites.js",
        "src/detect.js",
        "src/vault.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "AI伏せ字ガード",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
